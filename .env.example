# Opcional. Sólo lo requieren utilidades del piloto cuyos manifiestos conservan rutas
# hacia el corpus fuente original.
# DATASET_ROOT=/mnt/datasets/data/corn-leaf-source

# (Opcional) Raíz de resultados generados (modelos, métricas, previews y reportes).
# Si se omite, el pipeline usa <repo>/outputs.
# OUTPUT_ROOT=/outputs

# (Opcional) Raíz de datos derivados reproducibles del segmentador.
# Si se omite, el pipeline usa <repo>/data. No sustituye DATASET_ROOT.
# PROJECT_DATA_ROOT=/project/data
