# Ruta raíz del dataset. Debe contener las carpetas raw/ (opcional) y clean/
# - Servidor: ruta del volumen montado
# - Local: cualquier ruta de la máquina donde se encuentre el dataset
#
# Ejemplos por sistema operativo (usa solo una línea, la que aplique a tu entorno):
#   Linux/servidor: DATASET_ROOT=/mnt/datasets/data/corn-leaf-diseases
#   macOS:          DATASET_ROOT=/Users/tu_usuario/datasets/corn-leaf-diseases
#   Windows:         DATASET_ROOT=C:/Users/tu_usuario/datasets/corn-leaf-diseases
DATASET_ROOT=/mnt/datasets/data/corn-leaf-diseases

HF_DATASET_REPO=daiv05/corn-leaf-diseases-pests-and-deficiencies
HF_TOKEN=

GDRIVE_DATASET_ID=

# (Opcional) Raíz de resultados generados (modelos, métricas, previews y reportes).
# Si se omite, el pipeline usa <repo>/outputs.
# OUTPUT_ROOT=/outputs

# (Opcional) Raíz de datos derivados reproducibles (splits y pilotos).
# Si se omite, el pipeline usa <repo>/data. No sustituye DATASET_ROOT.
# PROJECT_DATA_ROOT=/outputs/data
